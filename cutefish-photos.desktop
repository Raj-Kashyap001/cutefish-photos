[Desktop Entry]
Version=1.0
Name=Photos
Comment=Browse and view your photos
Exec=cutefish-photos %F
Icon=cutefish-photos
StartupWMClass=cutefish-photos
Terminal=false
Type=Application
Categories=Graphics;Photography;Viewer;
Keywords=Photo;Image;Picture;Gallery;
StartupNotify=true
MimeType=image/png;image/jpeg;image/webp;image/tiff;image/gif;image/bmp;image/heif;image/avif;image/jxl;image/x-icon;image/x-portable-anymap;image/svg+xml;
